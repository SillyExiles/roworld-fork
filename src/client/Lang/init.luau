--!strict
-- Empires Front (2026-11-07): the game in the player's language: Portuguese, Spanish or Russian, else
-- English. Every text the player reads already goes through client/EraText (it watches the PlayerGui's
-- text objects); EraText asks Lang twice:
--
--   Lang.tr(s)     before the era's words: s as the game wrote it (English, the base game's words) in
--                  the player's language, from its dictionary (Lang/<Code>, generated by tools/lang/build.py
--                  from tools/lang/texts*.py): an exact entry, else a
--                  template (an entry with %s / %d / %.1f / {name} in it: the rest of the text must match,
--                  the values go into the translation in order, or by {1} {2} / {name}), else the text
--                  cut at its separators (" · ", line breaks) and each piece looked up. A text left in
--                  English keeps the base game's words for EraText to swap.
--   Lang.terms(s)  after the era's words: words from the dictionary's `terms`, longest first, whole words
--                  only (empty for now: the interface is translated, the era's and places' names are not;
--                  in another language the buildings and weapons read as the base game's names translated).
--
-- The language: the player's Roblox language (Player.LocaleId) when it is one of ours; else, for an
-- account left in English, the country it plays from (LocalizationService:GetCountryRegionForPlayerAsync):
-- Brazil, Portugal and the Lusophone countries Portuguese, Spain and Latin America Spanish, Russia and
-- its neighbours Russian. The Settings' Language (Net/Settings `lang`, "auto" by default) overrides both.
local Lang = {}

-- (Roblox's side, looked up when needed; tests/ef/lang.luau stands in for both)
Lang.services = function(): (any, any)
	return game:GetService("Players"), game:GetService("LocalizationService")
end
Lang.find = function(name: string): any
	return script:FindFirstChild(name)
end

Lang.CODES = { "en", "pt", "es", "ru" }
Lang.NAMES = { en = "English", pt = "Português", es = "Español", ru = "Русский" }

--- Countries whose players get a language though their account is in English (ISO 3166 alpha-2).
Lang.COUNTRY = {
	BR = "pt", PT = "pt", AO = "pt", MZ = "pt", CV = "pt", GW = "pt", ST = "pt", TL = "pt",
	ES = "es", MX = "es", AR = "es", CO = "es", CL = "es", PE = "es", VE = "es", EC = "es", GT = "es",
	CU = "es", BO = "es", DO = "es", HN = "es", PY = "es", SV = "es", NI = "es", CR = "es", PA = "es",
	UY = "es", PR = "es", GQ = "es",
	RU = "ru", BY = "ru", KZ = "ru", KG = "ru", TJ = "ru", UZ = "ru", TM = "ru", AM = "ru", AZ = "ru",
	MD = "ru", GE = "ru",
}

local code = "en"
local dict: { [string]: string } = {}
local upper_dict: { [string]: string } = {}
local templates: { any } = {}
local terms: { { string } } = {}
local memo: { [string]: string } = {}
local memo_n = 0
local MEMO_MAX = 8000
local changed: { () -> () } = {}

-- ---------------------------------------------------------------------------------------------
-- UTF-8 upper case (Latin-1 accents and Cyrillic: string.upper only knows ASCII)
-- ---------------------------------------------------------------------------------------------

local function upper_cp(c: number): number
	if c >= 97 and c <= 122 then
		return c - 32
	elseif c >= 0xE0 and c <= 0xFE and c ~= 0xF7 then -- à..þ
		return c - 32
	elseif c >= 0x430 and c <= 0x44F then -- а..я
		return c - 32
	elseif c >= 0x450 and c <= 0x45F then -- ѐ..џ (ё)
		return c - 80
	end
	return c
end

function Lang.upper(s: string): string
	if not string.find(s, "[\128-\255]") then
		return string.upper(s)
	end
	local ok, out = pcall(function()
		local cps = {}
		for _, c in utf8.codes(s) do
			table.insert(cps, upper_cp(c))
		end
		return utf8.char(table.unpack(cps))
	end)
	return if ok then out else string.upper(s)
end

local function is_upper_text(s: string): boolean
	return string.find(s, "%u") ~= nil and string.find(s, "%l") == nil
end

-- ---------------------------------------------------------------------------------------------
-- Templates
-- ---------------------------------------------------------------------------------------------

local function esc(s: string): string
	return (string.gsub(s, "[%^%$%(%)%%%.%[%]%*%+%-%?]", "%%%0"))
end

--- A placeholder in a key: %s, %d, %5d, %.1f, %02d, %i, or {name}
local PH = "%%[%-%d%.]*[sdfi]"

local function compile(key: string, value: string): any?
	local parts: { string } = {}
	local names: { string } = {}
	local pos = 1
	local pat = "^"
	while true do
		local a, b = string.find(key, PH, pos)
		local c, d, nm = string.find(key, "{([%w_]+)}", pos)
		local first: number?, last: number?, name: string = nil, nil, ""
		if a ~= nil and (c == nil or a < c) then
			first, last = a, b
			name = tostring(#names + 1)
		elseif c ~= nil then
			first, last, name = c, d, nm :: string
		end
		if first == nil then
			pat ..= esc(string.sub(key, pos))
			break
		end
		pat ..= esc(string.sub(key, pos, (first :: number) - 1))
		-- (a %d is digits, signs, separators; a %s anything, as little as it takes)
		local tok = string.sub(key, first :: number, last :: number)
		if string.match(tok, "^%%[%-%d%.]*[dfi]$") then
			pat ..= "([%-%+]?[%d,%.]+)"
		elseif string.find(key, "^ %%[%-%d%.]*[sdfi]", (last :: number) + 1) then
			-- ("the %s %s gold": a name, then an amount; the name takes all but the last word)
			pat ..= "(.+)"
		else
			pat ..= "(.-)"
		end
		table.insert(names, name)
		table.insert(parts, tok)
		pos = (last :: number) + 1
		-- %% in a key is a literal percent sign
	end
	pat ..= "$"
	pat = string.gsub(pat, "%%%%%%%%", "%%%%")
	if #names == 0 then
		return nil
	end
	local bare = string.gsub(string.gsub(key, PH, "\0"), "{[%w_]+}", "\0")
	local literal = #string.gsub(bare, "\0", "")
	local anchor = ""
	for _, piece in string.split(string.gsub(bare, "%%%%", "%%"), "\0") do
		if #piece > #anchor then
			anchor = piece
		end
	end
	return { pat = pat, names = names, parts = parts, value = value, literal = literal, key = key, anchor = anchor }
end

--- A template's text value in the player's language (2026-11-07): a list ("few troops, far from the
--- capital") item by item, and "a Port" / "an Airfield" as the name without the English article.
local function tr_value(x: string): string
	if string.find(x, ", ", 1, true) then
		local parts = string.split(x, ", ")
		local changed = false
		for i, part in parts do
			local p2 = Lang.tr(part)
			changed = changed or p2 ~= part
			parts[i] = p2
		end
		if changed then
			return table.concat(parts, ", ")
		end
	end
	local y = Lang.tr(x)
	if y == x then
		local rest = string.match(x, "^[Aa]n? (.+)$")
		if rest ~= nil then
			local r2 = Lang.tr(rest)
			if r2 ~= rest then
				return r2
			end
		end
	end
	return y
end

local function fill(t: any, caps: { string }): string
	local v = t.value
	local by_name: { [string]: string } = {}
	for i, nm in t.names do
		by_name[nm] = caps[i]
		by_name[tostring(i)] = caps[i]
	end
	-- {1} {2} {name}: by number or name; then the format tokens take the values left, in order
	local taken: { [number]: boolean } = {}
	v = string.gsub(v, "{([%w_]+)}", function(nm: string)
		local x = by_name[nm]
		if x ~= nil then
			local i = tonumber(nm)
			if i ~= nil then
				taken[i] = true
			end
			return tr_value(x)
		end
		return nil
	end)
	local used = 0
	-- (a %s is text too: a structure's or a weapon's name, "the objective"; a number stays as it is)
	v = string.gsub(v, PH, function(tok: string)
		used += 1
		while taken[used] do
			used += 1
		end
		local x = caps[used] or ""
		if string.sub(tok, -1) == "s" and string.find(x, "%a%a") then
			return tr_value(x)
		end
		return x
	end)
	v = string.gsub(v, "%%%%", "%%")
	return v
end

-- ---------------------------------------------------------------------------------------------
-- Loading
-- ---------------------------------------------------------------------------------------------

local function load(c: string)
	code = c
	table.clear(dict)
	table.clear(upper_dict)
	table.clear(templates)
	table.clear(terms)
	table.clear(memo)
	memo_n = 0
	if c == "en" then
		return
	end
	local name = string.upper(string.sub(c, 1, 1)) .. string.sub(c, 2)
	-- (the dictionaries are this module's children: Lang/Pt, Lang/Es, Lang/Ru)
	local mod = Lang.find(name)
	if mod == nil then
		code = "en"
		return
	end
	local ok, data
	if type(mod) == "table" then
		ok, data = true, mod
	else
		ok, data = pcall(require, mod)
	end
	if not ok or type(data) ~= "table" then
		warn("[Lang] could not load " .. name .. ": " .. tostring(data))
		code = "en"
		return
	end
	local texts: { [string]: string } = data.texts or {}
	if data.values ~= nil then
		-- (the values in the order of Lang/Keys)
		local keys = Lang.find("Keys")
		local kok, klist = true, keys
		if type(keys) ~= "table" then
			kok, klist = pcall(require, keys)
		end
		if kok and type(klist) == "table" then
			texts = {}
			for i, k in klist do
				local v = data.values[i]
				if type(v) == "string" and v ~= "" then
					texts[k] = v
				end
			end
		end
	end
	for k, v in texts do
		if type(k) == "string" and type(v) == "string" and v ~= "" then
			if string.find(k, PH) or string.find(k, "{[%w_]+}") then
				local t = compile(k, v)
				if t ~= nil then
					table.insert(templates, t)
				end
			else
				dict[k] = v
			end
			-- (headers are often upper-cased by the UI: "Settings" shown as "SETTINGS")
			local uk = string.upper(k)
			if uk ~= k and dict[uk] == nil then
				upper_dict[uk] = Lang.upper(v)
			end
		end
	end
	-- (the most literal templates first: "Your %s" must not take what "Your rain falls on %d" means)
	-- (2026-11-07: then the fewer values: "From %s." before "%s from %s", which took "From few troops,
	-- far from the capital." apart)
	table.sort(templates, function(a, b)
		if a.literal ~= b.literal then
			return a.literal > b.literal
		end
		if #a.names ~= #b.names then
			return #a.names < #b.names
		end
		return a.key < b.key
	end)
	for en, x in data.terms or {} do
		table.insert(terms, { en, x })
	end
	table.sort(terms, function(a, b)
		return #a[1] > #b[1]
	end)
	for i, t in terms do
		terms[i] = { t[1], t[2], "%f[%w]" .. esc(t[1]) .. "%f[%W]" }
	end
end

-- ---------------------------------------------------------------------------------------------
-- Translating
-- ---------------------------------------------------------------------------------------------

local function lookup(s: string): string?
	local v = dict[s]
	if v ~= nil then
		return v
	end
	v = upper_dict[s]
	if v ~= nil then
		return v
	end
	-- (leading / trailing spaces and punctuation the UI adds: "Gold:", "  Build")
	local sl, sc, st = string.match(s, "^(%s*)(.-)(%s*)$")
	if sc ~= nil and sc ~= s and sc ~= "" then
		v = dict[sc] or upper_dict[sc]
		if v ~= nil then
			return sl .. v .. st
		end
	end
	local lead, core, trail = string.match(s, "^([%s%p]*)(.-)([%s%p]*)$")
	if core ~= nil and core ~= s and core ~= "" then
		v = dict[core] or upper_dict[core]
		if v ~= nil then
			return lead .. v .. trail
		end
	end
	for _, t in templates do
		-- (its longest fixed piece first: a cheap find before the pattern)
		if t.anchor ~= "" and not string.find(s, t.anchor, 1, true) then
			continue
		end
		local caps = { string.match(s, t.pat) }
		if #caps > 0 then
			local out = fill(t, caps)
			if is_upper_text(s) and not is_upper_text(t.key) then
				out = Lang.upper(out)
			end
			return out
		end
	end
	return nil
end

local SEPS = { "\n", "  ·  ", " · ", " — ", ": " }

local function tr_raw(s: string, depth: number): string
	-- (2026-11-07) a list of known words ("few troops, far from the capital"): each item, before a
	-- template could take the whole of it apart ("%s from %s")
	if dict[s] == nil and string.find(s, ", ", 1, true) then
		local parts = string.split(s, ", ")
		local all = true
		for i, part in parts do
			local x = dict[part] or upper_dict[part]
			if x == nil then
				all = false
				break
			end
			parts[i] = x
		end
		if all then
			return table.concat(parts, ", ")
		end
	end
	local v = lookup(s)
	if v ~= nil then
		return v
	end
	if depth > 3 then
		return s
	end
	for _, sep in SEPS do
		if string.find(s, sep, 1, true) then
			local out = {}
			local any = false
			for _, piece in string.split(s, sep) do
				local t = if piece == "" then piece else tr_raw(piece, depth + 1)
				any = any or t ~= piece
				table.insert(out, t)
			end
			if any then
				return table.concat(out, sep)
			end
		end
	end
	return s
end

--- `s` (the game's English) in the player's language; itself when there is no translation.
function Lang.tr(s: string): string
	if code == "en" or type(s) ~= "string" or s == "" or not string.find(s, "%a") then
		return s
	end
	local m = memo[s]
	if m ~= nil then
		return m
	end
	local out = tr_raw(s, 0)
	if memo_n > MEMO_MAX then
		table.clear(memo)
		memo_n = 0
	end
	memo[s] = out
	memo[out] = out
	memo_n += 2
	return out
end

--- The era's English names in `s` (after EraText) in the player's language.
function Lang.terms(s: string): string
	if code == "en" or #terms == 0 or not string.find(s, "%a%a") then
		return s
	end
	local out = s
	for _, t in terms do
		if string.find(out, t[1], 1, true) then
			out = string.gsub(out, t[3], t[2])
		elseif is_upper_text(out) and string.find(out, string.upper(t[1]), 1, true) then
			out = string.gsub(out, "%f[%w]" .. esc(string.upper(t[1])) .. "%f[%W]", Lang.upper(t[2]))
		end
	end
	return out
end

function Lang.code(): string
	return code
end

--- Picks the language: `pref` ("auto" or a code), else the account's language, else its country.
function Lang.choose(pref: string?): string
	if pref ~= nil and pref ~= "auto" and table.find(Lang.CODES, pref) then
		return pref
	end
	local Players, LocalizationService = Lang.services()
	local lp = Players.LocalPlayer
	local loc = string.lower(tostring(lp and lp.LocaleId or "en-us"))
	local base = string.sub(loc, 1, 2)
	if base == "pt" or base == "es" or base == "ru" then
		return base
	end
	if base ~= "en" then
		return "en"
	end
	-- (an account in English: the country it plays from)
	local ok, country = pcall(function()
		return LocalizationService:GetCountryRegionForPlayerAsync(lp)
	end)
	if ok and type(country) == "string" then
		return Lang.COUNTRY[string.upper(country)] or "en"
	end
	return "en"
end

--- Sets the language (a code); the texts on screen follow (EraText re-runs them).
function Lang.set(c: string)
	if not table.find(Lang.CODES, c) then
		c = "en"
	end
	if c == code and (c == "en" or next(dict) ~= nil) then
		return
	end
	load(c)
	for _, f in changed do
		task.spawn(f)
	end
end

--- The player's choice ("auto" or a code) in force: the last one asked for wins, though looking up
--- the country takes a moment (an early "auto" never overrides the saved setting read after it).
local pref: string? = nil

function Lang.apply(p: string?)
	local want = p or "auto"
	pref = want
	local c = Lang.choose(want)
	if pref == want then
		Lang.set(c)
	end
end

--- "auto" until the saved setting says otherwise.
function Lang.apply_default()
	if pref == nil then
		Lang.apply("auto")
	end
end

function Lang.on_change(f: () -> ())
	table.insert(changed, f)
end

return Lang
