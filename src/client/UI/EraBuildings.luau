for name, hex in DATA do
	local rows = table.create(16)
	for y = 0, 15 do
		local v = tonumber(string.sub(hex, y * 4 + 1, y * 4 + 4), 16) or 0
		local r = table.create(16)
		for x = 0, 15 do
			r[x + 1] = if bit32.btest(v, bit32.lshift(1, 15 - x)) then "W" else "."
