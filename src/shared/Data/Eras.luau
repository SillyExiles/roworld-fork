-- Empires Front (2026-10-31): the free-for-all maps of the continents (Africa, Europe, North and South
-- America: modern nations) play in the Age of Nations, the Great War's words, rules and arms.
do
	local ru = nil
	for _, e in Eras.list do
		if e.id == "russia" then
			ru = e
		end
	end
	if ru ~= nil then
		-- (Russia's words, but a Palace stays a Palace and a Fortress is a Citadel in the Age of Nations)
		local words = {}
		for _, w in ru.words do
			if w[1] ~= "Palace" and w[1] ~= "Fortress" and w[1] ~= "University" then
				table.insert(words, w)
			end
		end
		table.insert(words, 1, { "Fortress", "Citadel" })
		table.insert(Eras.list, {
			id = "nations",
			name = "Age of Nations",
			period = "1914 · Free for all",
			words = words,
			rules = ru.rules,
			forge = ru.forge,
		})
	end
end

-- Empires Front (2026-11-06): the siege weapons' balance by the period's style (Core/Rules reads
-- `nuke` = { inner, outer, speed, cost } in full-size tiles, `silo_range_full` the Siege Workshop's
-- reach and `sam_range` the Watchtower's x the base range). A bombard is small; fire is wider and
-- spreads; the plague has no blast (its ring is only for aiming). (2026-11-06: the workshops reach far,
-- 650 / 750 / 900 tiles, a player may have up to 15 of them, and the plague costs a fortune: Core/Rules
-- doubles it with each use.)
Eras.SIEGE = {
	ancient = {
		nuke = {
			atom = { 6, 14, 6, 400000 },
			hydrogen = { 10, 20, 5, 1500000 },
			plague = { 0, 4, 5, 4000000 },
			firerain = { 3, 8, 8, 6000000 },
		},
		silo_range_full = 650,
		sam_range = 0.5,
	},
	gunpowder = {
		nuke = {
			atom = { 8, 17, 8, 500000 },
			hydrogen = { 11, 22, 6, 1800000 },
			plague = { 0, 4, 6, 4500000 },
			firerain = { 4, 9, 9, 7000000 },
		},
		silo_range_full = 750,
		sam_range = 0.6,
	},
	modern = {
		nuke = {
			atom = { 10, 20, 10, 600000 },
			hydrogen = { 13, 26, 8, 2200000 },
			plague = { 0, 4, 8, 5000000 },
			firerain = { 5, 10, 11, 8000000 },
		},
		silo_range_full = 900,
		sam_range = 0.75,
	},
}
Eras.SIEGE_STYLE = {
	rome = "ancient",
	greece = "ancient",
	persia = "ancient",
	inca = "ancient",
	aztec = "ancient",
	mali = "ancient",
	mongol = "ancient",
	ottoman = "gunpowder",
	japan = "gunpowder",
	china = "gunpowder",
	russia = "modern",
	britain = "modern",
	nations = "modern",
}
for _, e in Eras.list do
	local st = Eras.SIEGE[Eras.SIEGE_STYLE[e.id] or "ancient"]
	e.rules = if e.rules ~= nil then table.clone(e.rules) else {}
	e.rules.nuke = st.nuke
	e.rules.silo_range_full = st.silo_range_full
	e.rules.sam_range = st.sam_range
end

local by_id: { [string]: any } = {}
for _, e in Eras.list do
	by_id[e.id] = e
end

--- The era `id` (nil if unknown).
function Eras.get(id: string?): any
	return if id ~= nil then by_id[id] else nil
end

--- The active era's id (Core/Era sets it), nil before any map is bound.
Eras.active = nil :: string?

--- The active era's table, or nil.
function Eras.current(): any
	return Eras.get(Eras.active)
end

--- The Forge's bonus for an owner whose finished Forges add up to `levels` levels in the active era:
--- (attack, defence) as fractions (0.3 = 30%), and how many tiers are open.
function Eras.forge_bonus(levels: number): (number, number, number)
	local e = Eras.current()
	local tiers = if e ~= nil then e.forge else (Eras.list[1] :: any).forge
	local n = math.clamp(math.floor(levels), 0, #tiers)
	local atk, def = 0, 0
	for i = 1, n do
		atk += tiers[i].atk
		def += tiers[i].def
	end
	return atk, def, n
end

return Eras
