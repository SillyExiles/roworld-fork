--!strict
-- Empires Front: the eras. Every map is one empire in its own period (Data/MapList `era`), and the era
-- decides three things:
--
--   words     what the game calls its structures, ships and attacks there: the client renders every UI
--             text through Era.tr (client/EraText), which swaps the base game's modern words (left) for
--             the era's (right). Longest first; "Warship" also matches "warship", "WARSHIP" and the plural.
--   rules     balance of the period (Core/Rules applies them when the era is set): blast radii, ranges,
--             ship speed and toughness. Ancient siege engines hit small and near, a dreadnought far.
--   forge     the Forge's four tiers: the arms and armour each level of the player's Forges brings to all
--             of their troops (atk: they lose fewer troops attacking; def: attackers lose more).
--   objective (removed 2026-10-31: matches are won by holding the land; the old entries are unused)
--
-- Pure data: no requires (Core/Rules reads it while building its tables).

local Eras = {}

export type Era = {
	id: string,
	name: string,
	period: string,
	words: { { string } },
	rules: { [string]: any },
	forge: { { name: string, atk: number, def: number, text: string } },
	--- (unused since 2026-10-31: the objective win was removed)
	objective: { title: string, text: string, hold_s: number }?,
}

--- Shared by every era: the base game's words that read wrong in any period.
Eras.COMMON_WORDS = {
	{ "Nuclear weapons", "Siege weapons" },
	{ "nuclear weapons", "siege weapons" },
	{ "Radiation", "Ruin" },
	{ "Fallout zone", "Scorched land" },
	{ "Fallout", "Scorched land" },
	{ "fallout", "scorched land" },
	{ "Commander", "Emperor" },
}

