local by_id: { [string]: any } = {}
for _, e in Eras.list do
	by_id[e.id] = e
end

--- The era `id` (nil if unknown).
function Eras.get(id: string?): any
	return if id ~= nil then by_id[id] else nil
end

--- The active era's id (Core/Era sets it), nil before any map is bound.
Eras.active = nil :: string?

--- The active era's table, or nil.
function Eras.current(): any
	return Eras.get(Eras.active)
end

--- The Forge's bonus for an owner whose finished Forges add up to `levels` levels in the active era:
--- (attack, defence) as fractions (0.3 = 30%), and how many tiers are open.
function Eras.forge_bonus(levels: number): (number, number, number)
	local e = Eras.current()
	local tiers = if e ~= nil then e.forge else (Eras.list[1] :: any).forge
	local n = math.clamp(math.floor(levels), 0, #tiers)
	local atk, def = 0, 0
	for i = 1, n do
		atk += tiers[i].atk
		def += tiers[i].def
	end
	return atk, def, n
end

return Eras
